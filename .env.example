# ===================================================================
# MovieVerse Environment Variables Configuration Template
# Placeholders ONLY - Never commit real keys or secrets to GitHub
# ===================================================================

# OMDb API: Secret key for real-time movie posters and metadata
OMDB_API_KEY=your_omdb_api_key_here

# JWT Authentication Secret Key (Minimum 32 characters for HMAC-SHA256)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars

# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/movieverse_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# Application Host URL (Injected by runtime or localhost:3000)
APP_URL=http://localhost:3000

